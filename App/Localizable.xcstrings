    "Add your Google account in iPhone Settings › Apps › Calendar › Calendar Accounts to see Google Calendar events in the agenda too. Events are only read, never changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの設定 › アプリ › カレンダー › カレンダーアカウントにGoogleアカウントを追加すると、Googleカレンダーの予定もアジェンダに並びます。予定は読むだけで変更しません。"
          }
        }
      }
    },
    "Added to %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に追加しました。"
          }
        }
      }
    },
    "Adds text to where new memos are saved (refile.org by default).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを新規メモの保存先（既定は refile.org）に追記します。"
          }
        }
      }
    },
    "Adds the memo to %@.": {
