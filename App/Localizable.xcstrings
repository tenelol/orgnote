{
  "sourceLanguage": "en",
  "strings": {
    "#%@": {
      "shouldTranslate": false
    },
    "%@  %@ Priority": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@  %2$@ Priority"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@  優先度 %2$@"
          }
        }
      }
    },
    "%@ can’t be read as UTF-8 text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はUTF-8のテキストとして読めません"
          }
        }
      }
    },
    "%@ may have been moved or deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は移動または削除された可能性があります。"
          }
        }
      }
    },
    "%@ priority": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先度 %@"
          }
        }
      }
    },
    "%@ was also changed on another device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が他の端末でも変更されました"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "A date followed by how often it repeats.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ・%2$@"
          }
        }
      }
    },
